---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, path, noindex = false, structuredData } = Astro.props;
const dataItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <SeoHead title={title} description={description} path={path} noindex={noindex} />
    {dataItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
