---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import CallToAction from '../../components/CallToAction.astro';
---
<BaseLayout title="FM27 Scouting and Squad Tools | FM AI Assistent" description="Explore FM AI Assistent features for player scouting, tactics, recruitment, staff analysis and context-aware AI assistance." path="/features/">
  <div class="page-shell"><Breadcrumbs items={[{label:'Features'}]} />
    <header class="page-hero"><p class="eyebrow">Capability map</p><h1>Explore FM AI Assistent features.</h1><p class="lead">A local database for hands-on inspection, plus focused AI tools for the decisions that usually require many searches and comparisons.</p></header>
    <section class="section">
      <div class="feature-grid">
        <FeatureCard number="01" title="Scout players" description="Search the current snapshot and examine attributes, positions, contracts, wages, asking prices and club context." href="/features/scouting/" />
        <FeatureCard number="02" title="Analyze tactics" description="Decode an exported tactic, inspect role requirements, diagnose depth and build a unique optimized lineup." href="/features/tactics/" />
        <FeatureCard number="03" title="Plan recruitment" description="Find role-specific targets and replacements, compare finalists, model moves and preserve verified evidence." href="/features/recruitment/" />
        <FeatureCard number="04" title="Assess staff" description="Filter staff and compare all nine supported coaching assignments with transparent role calculations." href="/features/staff/" />
        <FeatureCard number="05" title="Ask an AI assistant" description="Choose Codex, Antigravity, Copilot or OpenRouter and control which save and tactic context is enabled." href="/features/ai-assistant/" />
        <FeatureCard number="06" title="Browse the database" description="Inspect players, staff, clubs and competitions in the local interface without needing an AI conversation." href="/how-it-works/" linkLabel="Understand the data flow" />
      </div>
    </section>
    <section class="section feature-showcase">
      <div><p class="eyebrow">Club intelligence</p><h2>A clear view of every club.</h2><p>Explore facilities and reputation in Overview, review budgets and wages in Finances, and check continental performance in Coefficients. Separate tabs keep each part of the club profile easy to find.</p></div>
      <figure class="screenshot-frame"><a href="/images/club-overview.png" target="_blank" rel="noopener" aria-label="Open the club overview screenshot at full size"><img src="/images/club-overview.png" width="1600" height="900" loading="lazy" alt="FM27 club profile with Overview, Finances and Coefficients tabs and a two-column facilities overview" /></a><figcaption><span>Club profiles use the same spacious layout as player details.</span><a href="/images/club-overview.png" target="_blank" rel="noopener">View full size ↗</a></figcaption></figure>
      <figure class="screenshot-frame"><a href="/images/club-finances.png" target="_blank" rel="noopener" aria-label="Open the club finances screenshot at full size"><img src="/images/club-finances.png" width="1600" height="900" loading="lazy" alt="FM27 club Finances tab showing balance, transfer budget and wage budget" /></a><figcaption><span>Financial details have their own dedicated tab.</span><a href="/images/club-finances.png" target="_blank" rel="noopener">View full size ↗</a></figcaption></figure>
      <figure class="screenshot-frame"><a href="/images/club-coefficients.png" target="_blank" rel="noopener" aria-label="Open the club coefficients screenshot at full size"><img src="/images/club-coefficients.png" width="1600" height="900" loading="lazy" alt="FM27 club Coefficients tab with continental ranking and season coefficients" /></a><figcaption><span>Continental rankings and season coefficients stay together.</span><a href="/images/club-coefficients.png" target="_blank" rel="noopener">View full size ↗</a></figcaption></figure>
    </section>
    <section class="section feature-showcase">
      <div><p class="eyebrow">Designed for verification</p><h2>See the rows behind the recommendation.</h2><p class="lead">The browser interface keeps the underlying data visible. AI decision tools return snapshot identity, tactic fingerprint, player IDs and the values used to compare options.</p><p>AI output is still advice—not an instruction sent into your save. Check uncertain prices, availability and tactical fit in FM27 before acting.</p></div>
      <figure class="screenshot-frame"><a href="/images/player-details.png" target="_blank" rel="noopener" aria-label="Open the player detail screenshot at full size"><img src="/images/player-details.png" width="1600" height="900" loading="lazy" alt="FM27 player Attributes tab with a selected Ball-Playing Centre-Back role and highlighted attribute priorities" /></a><figcaption><span>Player details highlight the attributes required by the selected possession role.</span><a href="/images/player-details.png" target="_blank" rel="noopener">View full size ↗</a></figcaption></figure>
    </section>
  </div>
  <CallToAction />
</BaseLayout>
