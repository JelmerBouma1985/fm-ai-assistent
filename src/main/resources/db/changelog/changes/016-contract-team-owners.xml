<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="016-contract-team-owners" author="codex">
        <addColumn tableName="player_contracts">
            <column name="team_owner_kind" type="VARCHAR(32)"/>
            <column name="team_owner_uid" type="BIGINT"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="player_contracts" columnName="team_owner_uid"/>
            <dropColumn tableName="player_contracts" columnName="team_owner_kind"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
