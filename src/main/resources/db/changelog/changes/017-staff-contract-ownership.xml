<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="017-staff-contract-ownership" author="codex">
        <addColumn tableName="player_contracts"><column name="staff_id" type="BIGINT"/></addColumn>
        <dropNotNullConstraint tableName="player_contracts" columnName="player_id" columnDataType="BIGINT"/>
        <addForeignKeyConstraint baseTableName="player_contracts" baseColumnNames="staff_id"
                                 referencedTableName="staff" referencedColumnNames="id"
                                 constraintName="fk_contract_staff" onDelete="CASCADE"/>
        <addUniqueConstraint tableName="player_contracts" columnNames="staff_id,slot" constraintName="uq_staff_contract_slot"/>
        <sql>ALTER TABLE player_contracts ADD CONSTRAINT ck_contract_one_owner CHECK
            ((player_id IS NOT NULL AND staff_id IS NULL) OR (player_id IS NULL AND staff_id IS NOT NULL))</sql>
        <rollback>
            <!-- Refuse rollback while staff-only rows exist, before dropping any staff data or constraints. -->
            <addNotNullConstraint tableName="player_contracts" columnName="player_id" columnDataType="BIGINT"/>
            <sql>ALTER TABLE player_contracts DROP CONSTRAINT ck_contract_one_owner</sql>
            <dropUniqueConstraint tableName="player_contracts" constraintName="uq_staff_contract_slot"/>
            <dropForeignKeyConstraint baseTableName="player_contracts" constraintName="fk_contract_staff"/>
            <dropColumn tableName="player_contracts" columnName="staff_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
