<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="015-contract-term-references" author="codex">
        <addColumn tableName="contract_terms">
            <column name="reference_kind" type="VARCHAR(16)"/>
            <column name="reference_uid" type="BIGINT"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="contract_terms" columnName="reference_uid"/>
            <dropColumn tableName="contract_terms" columnName="reference_kind"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
